# ==============================================================================
# CHAINTRACE — .gitignore
# ==============================================================================

# Dependencies
node_modules/
backend/venv/
__pycache__/
*.py[cod]
*$py.class

# Environment files with real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
.env.*.local

# Next.js & TypeScript build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts.bak

# Testing & Linting caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.eslintcache

# Python packaging
*.egg-info/
*.egg

# Database files
*.db
*.sqlite
*.sqlite3

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backup directory (dev only)
_backup_prejudge/

