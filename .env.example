# ==============================================================================
# CHAINTRACE // BLOCKCHAIN INTELLIGENCE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Data Mode: 'demo' (simulated forensic datasets) or 'live' (real blockchain providers)
# In LIVE mode, queries are sent to configured real blockchain API providers.
# If credentials are missing in LIVE mode, a clear API_CONFIGURATION_ERROR is returned.
BLOCKCHAIN_DATA_MODE=demo

# Server-Side Blockchain Provider API Keys
# NOTE: Never prefix with NEXT_PUBLIC_ to ensure they are NEVER exposed in the client bundle.
ETHEREUM_API_KEY=your_etherscan_api_key_here
POLYGON_API_KEY=your_polygonscan_api_key_here
TRON_API_KEY=your_trongrid_api_key_here

# Optional RPC & REST Endpoints (Defaults are set in code if omitted)
ETHEREUM_RPC_URL=https://cloudflare-eth.com
POLYGON_RPC_URL=https://polygon-rpc.com
TRON_API_URL=https://api.trongrid.io

# Request Cache TTL in milliseconds (default: 60000 = 1 minute)
BLOCKCHAIN_CACHE_TTL_MS=60000

# Transaction Fetch Limit (default: 25, max: 100)
BLOCKCHAIN_TX_LIMIT=25

# Public FastAPI Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
